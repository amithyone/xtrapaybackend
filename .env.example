APP_NAME="Xtrapay"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
# Runtime secrets file on the server is `.error` (not `.env`). Copy this template:
#   cp .env.example .error && php artisan key:generate
ADMIN_PATH=enter0
ADMIN_HONEYPOT_PATH=admin
ADMIN_HONEYPOT_ENABLED=true
# Production: set to your public marketing site (e.g. https://check-outpay.com), then run php artisan config:cache

# NigTax admin SPA (used in messages and redirects for tax-role admins)
TAX_ADMIN_URL=https://nigtax.com/admin

# NigTax certified PDF payments — REQUIRED for paid certified reports on nigtax.com
# Integer primary key from the `businesses` table (same merchant account that should receive VA payments).
# That business must have at least one row in business_websites (approved website) for webhooks.
# Find ids: SELECT id, name FROM businesses;  or use Checkout admin → Businesses.
# After changing: php artisan config:clear
NIGTAX_PAYMENT_BUSINESS_ID=
# Optional: override payment.approved webhook base URL; if empty, the business website URL is used
NIGTAX_PAYMENT_WEBHOOK_URL=

# NigTax PRO (Taxcalculate): monthly membership slug and auto-seeded product (migration 2026_04_04_120001).
# After setting NIGTAX_PAYMENT_BUSINESS_ID, run: php artisan migrate
NIGTAX_PRO_MEMBERSHIP_SLUG=nigtax-pro
# After NigTax PRO password reset, users are redirected here (e.g. https://nigtax.com). Optional; defaults to APP_URL.
NIGTAX_CALCULATOR_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xtrapay
DB_USERNAME=xtrapay_user
DB_PASSWORD=xtrapay_pass_change_me
# Domain connections default to DB_DATABASE until CREATE DATABASE + table moves.
# DB_IDENTITY_DATABASE=xtrapay_identity
# DB_KYC_DATABASE=xtrapay_kyc
# DB_LEDGER_DATABASE=xtrapay_ledger
# DB_MERCHANT_DATABASE=xtrapay_merchant
# DB_OPS_DATABASE=xtrapay_ops
# Security hardening for SQL injection / destructive SQL
SQL_INJECTION_GUARD_ENABLED=true
DB_QUERY_FIREWALL_ENABLED=true
# Keep false so migrations/CLI maintenance are not blocked
DB_QUERY_FIREWALL_BLOCK_IN_CONSOLE=false
# Daily backup retention (used by scripts/mysql-backup.sh)
MYSQL_BACKUP_KEEP=5
MYSQL_BACKUP_COMPRESS=true
# Secure live → Contabo data sync
# Contabo (receiver): LIVE_SYNC_ENABLED=true + KEY_ID + SECRET
# Namecheap (transmitter / source of truth): LIVE_SYNC_TRANSMIT_ENABLED=true + RECEIVER_URL + same KEY_ID/SECRET
# Do NOT enable transmit on Contabo (avoids echo loops).
LIVE_SYNC_ENABLED=false
LIVE_SYNC_TRANSMIT_ENABLED=false
LIVE_SYNC_RECEIVER_URL=https://check-outnow.com/api/v1/sync/live
LIVE_SYNC_RECEIVER_PATH=/api/v1/sync/live
LIVE_SYNC_KEY_ID=live-site-1
LIVE_SYNC_SECRET=
LIVE_SYNC_SOURCE_NAME=namecheap-live
LIVE_SYNC_MAX_DRIFT_SECONDS=300
LIVE_SYNC_NONCE_TTL_SECONDS=600
LIVE_SYNC_TIMEOUT_SECONDS=15
LIVE_SYNC_QUEUE=true
# Namecheap incremental cron (live-sync:incremental every N minutes)
LIVE_SYNC_INCREMENTAL_CRON=false
LIVE_SYNC_INCREMENTAL_CRON_MINUTES=5
LIVE_SYNC_BATCH_CHUNK_SIZE=25
LIVE_SYNC_BATCH_MAX_EVENTS=50
LIVE_SYNC_PROBE_CHUNK_SIZE=50
LIVE_SYNC_PROBE_TIMEOUT_SECONDS=60
LIVE_SYNC_PRESERVE_TIMESTAMPS=true
LIVE_SYNC_PRESERVE_CREATED_ON_UPDATE=true
# Optional source IP allowlist on the receiver (comma-separated), e.g. Namecheap egress IP
LIVE_SYNC_ALLOWED_IPS=

# Shared secret for sensitive HTTP cron / internal triggers (REQUIRED on production):
# /api/v1/transaction/check, /api/v1/cron/process-webhooks, /api/v1/statistics,
# and web /cron/* routes. Pass as header X-Cron-Token or ?token=
CRON_EMAIL_FETCH_TOKEN=

# Set true after first install — permanently blocks /setup/* (prevents unauthenticated .error writes)
APP_SETUP_COMPLETE=false

# Off: check-outpay.com and check-outnow.com each serve locally (no browser redirect).
LEGACY_HOST_REDIRECT_ENABLED=false
LEGACY_HOST_REDIRECT_TO=https://check-outnow.com
LEGACY_HOSTS=check-outpay.com,www.check-outpay.com
LEGACY_HOST_REDIRECT_SKIP_PREFIXES=/api/,/cron/,/internal/,/mevon-egress,/enter0,/investor
# Do not 301 these hosts to APP_URL (both domains stay on their own name).
CANONICAL_ALIAS_HOSTS=check-outpay.com,www.check-outpay.com,check-outnow.com,www.check-outnow.com

# Contabo client → Namecheap receiver (same secret on both). Disable after DNS cutover.
# Contabo:
# WEBHOOK_EGRESS_RELAY_CLIENT_ENABLED=true
# WEBHOOK_EGRESS_RELAY_URL=https://check-outpay.com/api/v1/internal/webhook-egress
# WEBHOOK_EGRESS_RELAY_SECRET=<long-random>
# WEBHOOK_EGRESS_FALLBACK_DIRECT=true
# WEBHOOK_EGRESS_ALLOWED_IPS=<contabo-public-ip>   # set on Namecheap receiver
# Namecheap:
# WEBHOOK_EGRESS_RELAY_RECEIVER_ENABLED=true
# WEBHOOK_EGRESS_RELAY_SECRET=<same>
WEBHOOK_EGRESS_RELAY_CLIENT_ENABLED=false
WEBHOOK_EGRESS_RELAY_RECEIVER_ENABLED=false
WEBHOOK_EGRESS_RELAY_URL=https://check-outpay.com/api/v1/internal/webhook-egress
WEBHOOK_EGRESS_RELAY_SECRET=
WEBHOOK_EGRESS_FALLBACK_DIRECT=true
WEBHOOK_EGRESS_ALLOWED_IPS=
WEBHOOK_EGRESS_USER_AGENT="CheckoutPay-Webhook/1.0 (+https://check-outpay.com)"

# Namecheap only: proxy merchant API (payment-request / account numbers) to Contabo.
# API_PROXY_TO_CONTABO_ENABLED=true
# API_PROXY_TO_CONTABO_URL=https://check-outnow.com
# API_PROXY_SKIP_PREFIXES=/api/v1/internal/webhook-egress,/api/v1/sync/live
# API_PROXY_FALLBACK_LOCAL=false
API_PROXY_TO_CONTABO_ENABLED=false
API_PROXY_TO_CONTABO_URL=https://check-outnow.com
API_PROXY_TO_CONTABO_TIMEOUT=25
API_PROXY_FALLBACK_LOCAL=false
API_PROXY_SKIP_PREFIXES=/api/v1/internal/webhook-egress,/api/v1/sync/live

# Self-quarantine: fail-closed when DB_HOST / DB name / row floors look hijacked (Aug 2026 pattern).
# Lock file: storage/framework/quarantine.lock (disk — not MySQL). Unlock with code or delete lock over SSH.
QUARANTINE_ENABLED=false
QUARANTINE_ALLOWED_DB_HOSTS=127.0.0.1,localhost
QUARANTINE_ALLOWED_DB_DATABASE=xtrapay
QUARANTINE_MIN_PAYMENTS=0
QUARANTINE_MIN_BUSINESSES=0
QUARANTINE_MIN_ADMINS=0
QUARANTINE_REQUIRED_TABLES=payments,businesses,admins,settings
QUARANTINE_UNLOCK_CODE=
QUARANTINE_CHECK_INTERVAL_SECONDS=60
# After restore: php artisan quarantine:baseline  → copy suggested floors into .error, set ENABLED=true

# Ops Sentinel (office wall-clock / tray) — separate from admin password
OPS_MONITOR_KEY=
OPS_HOST_ROLE=primary
# OPS_HOST_ROLE=relay on Namecheap. Optional IP allowlist (comma-separated); empty = any
OPS_MONITOR_ALLOWED_IPS=

# Alternative: PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=payment_gateway
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Share cookies across www + apex (e.g. .check-outnow.com). Required to avoid mobile 419 on login.
SESSION_DOMAIN=.check-outnow.com
# Must be true on HTTPS production. Null used to become false and omit Secure on the session cookie.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email Configuration (for receiving bank notifications)
# Gmail Setup: https://myaccount.google.com/apppasswords
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_ENCRYPTION=ssl
EMAIL_VALIDATE_CERT=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password

# Payment Configuration
PAYMENT_AMOUNT_TOLERANCE=0.01
PAYMENT_EXPIRATION_HOURS=24

# Global match: newest N unmatched emails per run (cron + admin); default 200
GLOBAL_MATCH_MAX_EMAILS=200

# Webhook Configuration
WEBHOOK_TIMEOUT=30
WEBHOOK_RETRY_ATTEMPTS=3

# VTU.ng (airtime/data/electricity). Required for consumer app Pay Bills (airtime/data) and WhatsApp wallet VTU.
# Set VTU_NG_ENABLED=true plus USERNAME and PASSWORD (JWT is obtained automatically from VTU_NG_API_BASE).
VTU_NG_ENABLED=false
VTU_NG_API_BASE=https://vtu.ng/wp-json/api/v2
VTU_NG_USERNAME=
VTU_NG_PASSWORD=
VTU_NG_PIN=
VTU_NG_TIMEOUT=60
# Refund/reversal webhook protection
VTU_NG_WEBHOOK_SECRET=
VTU_NG_WEBHOOK_ALLOWED_IPS=
VTU_NG_REFUND_STATUSES=refund,refunded,reversed,reversal,failed

# Squad (GTB) VTU — airtime & data. Switch provider in Admin → Settings → VTU.
# Sandbox: https://sandbox-api-d.squadco.com  Live: https://api-d.squadco.com
# Use the SECRET key as Bearer for vending (sandbox_sk_… / sk_…). Public key is optional.
SQUAD_VTU_ENABLED=false
SQUAD_VTU_BASE_URL=https://sandbox-api-d.squadco.com
SQUAD_VTU_SECRET_KEY=
SQUAD_VTU_PUBLIC_KEY=
SQUAD_VTU_AIRTIME_MIN=50
SQUAD_VTU_AIRTIME_MAX=50000

# BuyPower (electricity). Docs: https://docs.buypower.ng/
# Sandbox: https://se-api.buypower.ng  Live: https://api.buypower.ng
# Route electricity to buypower on Admin → VTU providers.
BUYPOWER_ENABLED=false
BUYPOWER_BASE_URL=https://se-api.buypower.ng
BUYPOWER_TOKEN=
BUYPOWER_EMAIL=
BUYPOWER_SANDBOX=true

# VTpass (airtime/data/electricity/TV/betting). Docs: https://vtpass.com/documentation/
# Sandbox: https://sandbox.vtpass.com/api  Live: https://vtpass.com/api
VTPASS_ENABLED=false
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=

# Match attempt logs: delete records older than this many days (daily cleanup at 02:00)
MATCH_ATTEMPTS_RETENTION_DAYS=30

# Google reCAPTCHA v3 (registration / rental checkout spam protection)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ENABLED=true
RECAPTCHA_VERSION=v3
RECAPTCHA_SCORE_THRESHOLD=0.5

# Transaction Transfer Feature (Super Admin Only)
# Set to true to enable, false to disable transaction transfer feature
TRANSACTION_TRANSFER_ENABLED=true

# NUBAN (account number validation – https://nuban.com.ng)
NUBAN_API_KEY=
NUBAN_BASE_URL=https://app.nuban.com.ng/api
NUBAN_POSSIBLE_BANKS_URL=https://app.nuban.com.ng/possible-banks
NUBAN_TIMEOUT_SECONDS=10

# MavonPay (instant withdrawals)
MEVONPAY_BASE_URL=
# Live shared hosting workaround: point BASE_URL at Contabo proxy, e.g. https://check-outnow.com/mevon-egress
# Contabo: MEVONPAY_EGRESS_PROXY_ENABLED=true + PROXY_TOKEN; Live: MEVONPAY_EGRESS_CLIENT_TOKEN=same token
# MEVONPAY_EGRESS_PROXY_ENABLED=false
# MEVONPAY_EGRESS_PROXY_TOKEN=
# MEVONPAY_EGRESS_PROXY_ALLOWED_IPS=199.188.201.182,199.188.201.190
# MEVONPAY_EGRESS_UPSTREAM=https://mevonpay.com.ng
# MEVONPAY_EGRESS_CLIENT_TOKEN=
MEVONPAY_SECRET_KEY=
MEVONPAY_DEBIT_ACCOUNT_NAME=
MEVONPAY_DEBIT_ACCOUNT_NUMBER=
MEVONPAY_CURRENT_PASSWORD=
MEVONPAY_TIMEOUT_SECONDS=20
# create_tem_va (temp account numbers). Default RC = platform (Checkout Now Ltd).
# Per-business override: admin checkbox "Request temp accounts under this business’s CAC name".
MEVONPAY_TEMP_VA_REGISTRATION_NUMBER=
MEVONPAY_TEMP_VA_PATH=/V1/create_tem_va
MEVONPAY_TEMP_VA_BANK_TYPE=Rubies
MEVONPAY_TEMP_VA_AUTH=bearer
# Merchant card checkout (Paga). Auth: raw (Authorization: secret) or bearer.
MEVONPAY_CARD_CHECKOUT_PATH=/V1/card_checkout
MEVONPAY_CARD_CHECKOUT_AUTH=raw
# Mevon NGN recon: expected = opening + Σ net_mevon_impact
# inbound +(gross−fee) · outbound success −(gross+fee) · failed 0
# After deploy: mevon:recon-recompute-impacts → mevon:ledger-backfill → reset baseline → mevon:check-balance /ops/v1/balances
MEVONPAY_INBOUND_FEE_THRESHOLD=10000
MEVONPAY_INBOUND_FEE_BELOW=30
MEVONPAY_INBOUND_FEE_AT_OR_ABOVE=50
MEVONPAY_OUTBOUND_API_FEE=10
# Merchant business withdrawals (Payout API + dashboard only; consumer wallets stay free)
MERCHANT_WITHDRAWAL_FEE_ENABLED=true
MERCHANT_WITHDRAWAL_FLAT_FEE=50
MEVONPAY_BVN_VERIFY_FEE=30
MEVONPAY_NIN_VERIFY_FEE=50
# KYC cron: only re-queue orphaned “queued” rows newer than N hours (avoids old BVN backlog).
MEVONPAY_KYC_REDISPATCH_ORPHANS=true
MEVONPAY_KYC_REDISPATCH_MAX_AGE_HOURS=6

# Providus Bank CheckoutRail (https://developer.providusbank.com)
# Transfer Services (name enquiry / NIP / TSQ) + DCS (reserved/dynamic VA + webhook)
# PROVIDUS_TRANSFER_BASE_URL=http://154.113.16.142:8882/postingrest
# PROVIDUS_DCS_BASE_URL=https://api-staging.providusbank.com
# PROVIDUS_USERNAME=
# PROVIDUS_PASSWORD=
# PROVIDUS_CLIENT_ID=
# PROVIDUS_CLIENT_SECRET=
# PROVIDUS_SOURCE_ACCOUNT_NAME=
# PROVIDUS_DEBIT_ACCOUNT_NUMBER=
# PROVIDUS_DEMO_MODE=false
# PROVIDUS_DEMO_SIGNATURE=

# VFD VBAAS Wallets API CheckoutRail (https://vbaas-docs.vfdtech.ng/docs/wallets-api/Products/wallets-api/)
# Leave AccessToken empty until VFD issues credentials. Do not set as the live default rail without a token.
# Test: https://api-devapps.vfdbank.systems/vtech-wallet/api/v2/wallet2
# Live: https://api-apps.vfdbank.systems/vtech-wallet/api/v2/wallet2
# Webhook: {APP_URL}/api/v1/webhook/checkout-rail/vfd
# VFD_BASE_URL=https://api-devapps.vfdbank.systems/vtech-wallet/api/v2/wallet2
# VFD_ACCESS_TOKEN=
# VFD_API_KEY=
# VFD_API_SECRET=
# VFD_WALLET_NAME=Checkout
# VFD_MERCHANT_ID=
# VFD_DEBIT_ACCOUNT_NUMBER=
# VFD_WEBHOOK_SECRET=

# Sudo Africa CheckoutRail card partner (POS terminals)
# Docs: https://docs.sudo.africa/docs/getting-started
# Sandbox: https://api.sandbox.sudo.cards  Live: https://api.sudo.africa
# Leave SUDO_API_KEY empty until Sudo issues a key. Do not point live POS at Sudo without it.
# Assign on /enter0/checkout-rail/assignments → POS card authorizations.
# Webhook (events): {APP_URL}/api/v1/webhook/checkout-rail/sudo
# JIT gateway (real-time auth): {APP_URL}/api/v1/webhook/checkout-rail/sudo/jit
# Cards use Sudo funding source type=gateway (balances stay on Checkout).
# SUDO_BASE_URL=https://api.sandbox.sudo.cards
# SUDO_API_KEY=
# SUDO_WEBHOOK_SECRET=
# SUDO_JIT_AUTHORIZATION_HEADER=
# SUDO_FUNDING_SOURCE_ID=
# SUDO_DEFAULT_CARD_ID=
# SUDO_MERCHANT_ID=XTRAPAY
# SUDO_MERCHANT_NAME=Xtrapay

# Interswitch Kimono / agency cash-out (POS card partner)
# Docs: https://docs.interswitchgroup.com/docs/cash-out-service-1
# Test cards: https://docs.interswitchgroup.com/docs/test-cards
# Geo: Kimono terminalGeoLocation (CBN geotagging). QA: https://qa.interswitchng.com
# Assign on /enter0/checkout-rail/cards → POS card authorizations.
# Webhook: {APP_URL}/api/v1/webhook/checkout-rail/interswitch
# INTERSWITCH_KIMONO_BASE_URL=https://qa.interswitchng.com
# INTERSWITCH_MERCHANT_ID=
# INTERSWITCH_TERMINAL_ID=
# INTERSWITCH_RECEIVING_INSTITUTION_ID=
# INTERSWITCH_DESTINATION_ACCOUNT_NUMBER=
# INTERSWITCH_SURCHARGE_KOBO=1075
# INTERSWITCH_CLIENT_ID=
# INTERSWITCH_CLIENT_SECRET=
# INTERSWITCH_WEBHOOK_SECRET=
# INTERSWITCH_DEMO_MODE=false
# Mass Tier-2 import batch — keep false; new users queue when they submit KYC.
WALLET_TIER2_BATCH_ENABLED=false
WALLET_TIER2_BATCH_INCLUDE_FAILED=false
MEVONPAY_RECONCILIATION_TOLERANCE=100
MEVONPAY_FLOAT_VS_MEVON_TOLERANCE=1000

# Smile ID — Kenya Tier 2 Basic KYC (National ID / IPRS). See docs/SMILE_ID_KENYA_KYC.md
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_SANDBOX=true
CONSUMER_KENYA_TIER2_ENABLED=false

# USD virtual card FX for Kenya wallets (KES per 1 USD). Also settable in enter0 Settings.
# VIRTUAL_CARD_FX_MID_USD_KES=
# VIRTUAL_CARD_FX_SELL_PROFIT_KES=5
# VIRTUAL_CARD_FX_BUY_PROFIT_KES=3

# Cashwyre Dollar Virtual Card (optional alternative to MevonPay cards). Admin Settings can pick active provider.
CASHWYRE_BASE_URL=https://businessapi.cashwyre.com/api/v1.0
CASHWYRE_APP_ID=
CASHWYRE_BUSINESS_CODE=
CASHWYRE_PUBLIC_KEY=
CASHWYRE_SECRET_KEY=
CASHWYRE_WEBHOOK_SECRET=
CASHWYRE_DEFAULT_CARD_BRAND=Visa
CASHWYRE_DEFAULT_PHONE_CODE=+234
# Override API paths only if Cashwyre docs change:
# CASHWYRE_PATH_CREATE_CARD=/CustomerCard/createCard

# Firebase Cloud Messaging — two apps, two Firebase projects (see storage/google-services.json for CheckoutNow client config)
#
# CheckoutNow wallet app (active)
CHECKOUTNOW_FCM_PROJECT_ID=checkout-now-a2b2f
# Service account from Firebase → checkout-now-a2b2f → Project settings → Service accounts → Generate key
CHECKOUTNOW_FCM_SERVICE_ACCOUNT_JSON=storage/app/fcm-checkoutnow.json
#
# ABJ Cam Rentals app (separate; not active yet)
RENTALS_FCM_PROJECT_ID=abjrentals-ef416
RENTALS_FCM_SERVICE_ACCOUNT_JSON=storage/app/fcm-service-account.json
#
# Legacy (optional fallback for rentals only if RENTALS_* unset):
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=

# CheckoutNow app — FCM when wallet receives money (bank top-up or P2P)
CONSUMER_WALLET_CREDIT_PUSH_ENABLED=true
CONSUMER_WALLET_CREDIT_PUSH_TITLE="Money received"
CONSUMER_WALLET_P2P_PUSH_TITLE="Money received"
# Android notification channel id for money-received pushes (CheckoutNow app)
CONSUMER_WALLET_CREDIT_PUSH_CHANNEL=money_received
#
# Peer-to-peer money requests (WhatsApp + CheckoutNow API)
CONSUMER_MONEY_REQUEST_ENABLED=true
CONSUMER_MONEY_REQUEST_EXPIRY_DAYS=7
CONSUMER_MONEY_REQUEST_MAX_PENDING_PER_PAIR=3
CONSUMER_SAVE_TOGETHER_ENABLED=true
CONSUMER_SAVE_TOGETHER_MIN_MEMBERS=2
CONSUMER_SAVE_TOGETHER_MAX_MEMBERS=20
CONSUMER_SAVE_TOGETHER_MIN_TARGET=100
CONSUMER_SAVE_TOGETHER_MIN_CONTRIBUTION=1
#
# CheckoutNow iOS — APNs direct send (same .p8 key as Firebase → Cloud Messaging → Apple app)
CHECKOUTNOW_APNS_KEY_ID=
CHECKOUTNOW_APNS_TEAM_ID=
CHECKOUTNOW_APNS_BUNDLE_ID=com.checkoutnow.mobile
CHECKOUTNOW_APNS_PRIVATE_KEY=storage/app/apns/AuthKey.p8
# production = TestFlight/App Store; sandbox = Xcode debug builds only
CHECKOUTNOW_APNS_ENVIRONMENT=production

# CheckoutNow passkeys / device trust (must match mobile associated domains)
CONSUMER_DEVICE_TRUST_ENABLED=true
# true = new device must reconfirm KYC + OTP + set new PIN when X-Device-Id differs
CONSUMER_DEVICE_STEPUP_REQUIRED_ON_LOGIN=true
CONSUMER_DEVICE_FIRST_TRUST_EMAIL_OTP=true
# Xtrapay native HMAC request signing (set true after app stores requestSigningSecret)
XTRAPAY_REQUEST_SIGNING_REQUIRED=false
XTRAPAY_REQUEST_SIGNING_MAX_DRIFT=300
# Native HMAC (X-XTP-* headers). Soft until mobile ships; then XTP_HMAC_ENFORCE=true
XTP_HMAC_ENFORCE=false
XTP_HMAC_SKEW=120
XTP_HMAC_NONCE_TTL=300
XTP_HMAC_KEY_TTL=45
# Xtrapay web SPA (Vercel)
XTRAPAY_WEB_APP_URL=https://xtrapay-psi.vercel.app
# Extra modules (insurance / telemed / POS network / CRM)
XTRAPAY_INSURANCE=true
XTRAPAY_TELEMED=true
XTRAPAY_POS_NETWORK=true
XTRAPAY_CRM=true
TELEMED_CONSULT_FEE=0
MYCOVER_BASE_URL=https://v2.api.mycover.ai
MYCOVER_SECRET_KEY=
MYCOVER_PUBLIC_KEY=
MYCOVER_WEBHOOK_SECRET=
CONSUMER_HIGH_VALUE_SINGLE_TRANSFER_CAP=20000
CONSUMER_TRANSFER_LOCK_HOURS=48
# Browser/web wallet daily outbound cap (NGN). Phone app is not capped by this.
CONSUMER_WEB_DAILY_TRANSFER_CAP_ENABLED=true
CONSUMER_WEB_DAILY_TRANSFER_CAP_NGN=10000
# Idle logout only after no API activity (minutes). Active use keeps the session alive.
CONSUMER_APP_SESSION_IDLE_MINUTES=60
# Sanctum hard lifetime (minutes); refreshed on every authenticated request
CONSUMER_TOKEN_ABSOLUTE_LIFETIME_MINUTES=43200
CONSUMER_WEBAUTHN_RP_ID=check-outpay.com
CONSUMER_WEBAUTHN_RP_NAME=CheckoutNow
# Comma-separated clientDataJSON origins. iOS uses https://check-outpay.com
# Android apk-key-hash origins are auto-derived from CONSUMER_ANDROID_ASSETLINKS_SHA256.
CONSUMER_WEBAUTHN_ALLOWED_ORIGINS=https://check-outpay.com
# Optional explicit Android hashes (usually unnecessary if ASSETLINKS is set):
# CONSUMER_WEBAUTHN_ANDROID_APK_KEY_HASHES=abc123...
# Android assetlinks.json: colon-separated SHA-256 fingerprints (comma-separated for debug+release)
# Then run: php artisan consumer:sync-android-assetlinks
# CONSUMER_ANDROID_ASSETLINKS_SHA256=AA:BB:CC:...

# Device step-up: trusted device push approval (alternative to BVN+OTP on new phone)
CONSUMER_DEVICE_STEPUP_PUSH_ENABLED=true
CONSUMER_DEVICE_STEPUP_PUSH_TTL_MINUTES=5
CONSUMER_DEVICE_STEPUP_PUSH_POLL_SECONDS=3

# Business name registration (CheckoutNow mobile — Receive Funds business slide)
CONSUMER_BUSINESS_NAME_REGISTRATION_ENABLED=false
CONSUMER_BUSINESS_NAME_REGISTRATION_FEE=15000
CONSUMER_BUSINESS_NAME_REGISTRATION_FEE_CURRENCY=NGN
CONSUMER_BUSINESS_NAME_REGISTRATION_COMING_SOON="Business name registration coming soon."
CONSUMER_BUSINESS_NAME_REGISTRATION_HOURS_MIN=12
CONSUMER_BUSINESS_NAME_REGISTRATION_HOURS_MAX=24

# CheckoutPay merchant business account onboarding (CheckoutNow Receive → Business)
CONSUMER_BUSINESS_ACCOUNT_ONBOARDING_ENABLED=false
CONSUMER_BUSINESS_ACCOUNT_ONBOARDING_FEE=0
CONSUMER_BUSINESS_ACCOUNT_ONBOARDING_FEE_CURRENCY=NGN
CONSUMER_BUSINESS_ACCOUNT_ONBOARDING_COMING_SOON="Business account onboarding coming soon."
CONSUMER_BUSINESS_ACCOUNT_DASHBOARD_LOGIN_URL=/dashboard/login

# WhatsApp — Evolution API or Meta WhatsApp Cloud API (official)
# Webhook URL (both providers): {WHATSAPP_APP_URL or APP_URL}/api/v1/whatsapp/webhook
#
# --- Meta Cloud (recommended for production) ---
# WHATSAPP_PROVIDER=cloud
# WHATSAPP_CLOUD_VERIFY_TOKEN=your-random-verify-token   # same string in Meta Developer → WhatsApp → Configuration
# WHATSAPP_CLOUD_ACCESS_TOKEN=                          # System user permanent token or temp from API Setup
# WHATSAPP_CLOUD_APP_SECRET=                            # Meta App → Settings → Basic → App Secret
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=                       # WhatsApp → API Setup → Phone number ID
# WHATSAPP_CLOUD_PHONE_NUMBER_ID_WALLET=                 # optional second line
# WHATSAPP_CLOUD_PHONE_NUMBER_ID_RENTALS=                # optional rentals line
# WHATSAPP_CLOUD_WABA_ID=                               # WhatsApp Business Account ID (optional, for reference)
# Callback URL in Meta: https://YOUR-DOMAIN/api/v1/whatsapp/webhook
# Full setup: reference/WHATSAPP_META_CLOUD_API.md
#
# --- Evolution (legacy) ---
# WHATSAPP_PROVIDER=evolution
# Live checklist: (1) WHATSAPP_APP_URL = public HTTPS (e.g. https://check-outpay.com).
# (2) WHATSAPP_EVOLUTION_* = base URL, api key, instance names.
# (3) WHATSAPP_WEBHOOK_SECRET optional; Evolution uses ?secret= or X-Checkout-WhatsApp-Secret.
# (4) php artisan whatsapp:configure-webhook --url='https://YOUR-DOMAIN/api/v1/whatsapp/webhook?secret=YOUR_SECRET'
WHATSAPP_PROVIDER=evolution
# Public Checkout base URL for WhatsApp (magic links, php artisan whatsapp:configure-webhook). Use HTTPS in production.
WHATSAPP_APP_URL=

# Customer-facing portals (WhatsApp copy / links). Defaults: business check-outnow.com, rentals abjrentals.ng, tax nigtax.com
PORTAL_URL_BUSINESS=https://check-outnow.com
PORTAL_URL_RENTALS=https://abjrentals.ng
PORTAL_URL_TAX=https://nigtax.com

# WhatsApp Wallet: web URL for signup, KYC, and full transaction history (falls back to WHATSAPP_APP_URL)
WHATSAPP_WALLET_APP_URL=https://app.check-outnow.com
# CheckoutNow store listings (marketing badges). Also editable in Admin → Settings → Marketing download links.
CHECKOUTNOW_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.checkoutnow.app
# CHECKOUTNOW_APP_STORE_URL=https://apps.apple.com/app/checkoutnow/id0000000000
# WordPress.org plugin listing for COPN Payment Gateway (admin override available)
# CHECKOUT_WORDPRESS_PLUGIN_URL=https://wordpress.org/plugins/copn-payment-gateway
# Optional full APK URL (default: same-origin /download/checkoutnow-android.apk on APP_URL)
# WHATSAPP_WALLET_ANDROID_APK_URL=
# Server path to APK file for the download route (default: /var/www/checkoutnow/dist/checkoutnow-android.apk)
# WHATSAPP_WALLET_ANDROID_APK_PATH=
# Tier 1 caps (WhatsApp-only wallet before Rubies VA)
WHATSAPP_WALLET_TIER1_MAX_BALANCE=50000
WHATSAPP_WALLET_TIER1_DAILY_TRANSFER=10000
# Self bank transfer fee when user sends to their own bank account (name or fintech phone match). Admin whatsapp-wallet settings override when set.
WHATSAPP_SELF_BANK_TRANSFER_FEE_ENABLED=true
# Percent default 0 until ops enables charging via admin (WhatsApp wallet settings)
WHATSAPP_SELF_BANK_TRANSFER_FEE_PERCENT=0
WHATSAPP_SELF_BANK_TRANSFER_FIXED_FEE=0
WHATSAPP_SELF_BANK_TRANSFER_MAX_FEE=500
# Tier 1 pay-in: MevonPay create_tem_va (new account each time user taps WALLET → 1). Requires MEVONPAY_TEMP_VA_REGISTRATION_NUMBER.
WHATSAPP_WALLET_TIER1_TEMP_VA_FNAME=WhatsApp
WHATSAPP_WALLET_TIER1_TEMP_VA_LNAME=User
WHATSAPP_WALLET_TIER1_TEMP_VA_TTL_HOURS=48
# Wallet signup/KYC: only these popular email domains (comma-separated). Others rejected.
# WHATSAPP_WALLET_ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com,yahoo.com,hotmail.com,outlook.com,live.com,icloud.com,protonmail.com,proton.me

WHATSAPP_WEBHOOK_SECRET=
# Meta WhatsApp Cloud API (when WHATSAPP_PROVIDER=cloud)
# WHATSAPP_CLOUD_VERIFY_TOKEN=
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_APP_SECRET=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID_WALLET=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID_RENTALS=
# WHATSAPP_CLOUD_WABA_ID=
# WHATSAPP_CLOUD_GRAPH_VERSION=v21.0
WHATSAPP_EVOLUTION_BASE_URL=https://wa-api.example.com
WHATSAPP_EVOLUTION_API_KEY=
WHATSAPP_EVOLUTION_INSTANCE=
# Evolution instance name for the rentals WhatsApp line. Must match Evolution name (send API is case-sensitive; e.g. Rentals not rentals). Admin Setting whatsapp_evolution_instance_rentals overrides when set.
WHATSAPP_EVOLUTION_INSTANCE_RENTALS=
# Optional: wallet outbound instance (defaults to WHATSAPP_EVOLUTION_INSTANCE). Admin whatsapp_evolution_instance_wallet overrides when set.
# WHATSAPP_EVOLUTION_INSTANCE_WALLET=
# Shared Checkout+Rentals on one number: set INSTANCE + INSTANCE_WALLET + INSTANCE_RENTALS to the same name, then:
# WHATSAPP_RENTALS_DEDICATED_ONLY=false
# Unsolicited WA alerts off by default (OTP + interactive bot still work):
# WHATSAPP_PROACTIVE_NOTIFICATIONS_ENABLED=false
# Optional: extra Evolution instance names per region (must match Evolution API). See config/whatsapp_wallet_regions.php
# WHATSAPP_EVOLUTION_INSTANCE_NAMIBIA=Namibia
# WHATSAPP_EVOLUTION_INSTANCE_ZAMBIA=Zambia
# WHATSAPP_EVOLUTION_INSTANCE_ZIMBABWE=Zimbabwe
# WHATSAPP_EVOLUTION_INSTANCE_BOTSWANA=Botswana
# WHATSAPP_EVOLUTION_INSTANCE_SOUTHAFRICA=South Africa
# WHATSAPP_EVOLUTION_INSTANCE_BENIN=Benin
# WHATSAPP_EVOLUTION_INSTANCE_TANZANIA=Tanzania
WHATSAPP_OTP_TTL_MINUTES=10
WHATSAPP_OTP_MAX_ATTEMPTS=5
# Meta Authentication template (Cloud API). Must be APPROVED in WhatsApp Manager.
# Users who have never messaged you cannot receive free-form OTP text.
WHATSAPP_OTP_TEMPLATE_NAME=checkoutnow_login_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_OTP_TEMPLATE_BUTTON=true

# Tagine restaurant app — optional LEGACY bridge (Tagine → POST /api/tagine/* with X-Tagine-Otp-Secret).
# If Tagine uses CHECKOUT_API_KEY instead, it calls POST /api/v1/whatsapp-wallet/send-message + /ensure — leave this empty.
# When set: Checkout does NOT generate OTP; Tagine stores the code; Checkout only sends WhatsApp via Evolution.
# Must match CHECKOUT_TAGINE_OTP_SECRET on Tagine when using the bridge.
TAGINE_OTP_SECRET=
# Optional: Checkout `renters.id` for Tagine merchant (wallet pay-ins / settlement wiring later).
TAGINE_WALLET_RENTER_ID=

# Merchant API: POST /api/v1/whatsapp-wallet/* with X-API-Key. Admin must enable whatsapp_wallet_api_enabled on the business.
# Merchant payout API: POST /api/v1/withdrawal with X-API-Key. Admin must enable payout_api_enabled on the business.
# Pay flow: POST /api/v1/whatsapp-wallet/pay/start → WhatsApp + secure PIN link → credits business + payment.approved webhook (no PIN-less debit API).
# Public marketing: optional https://wa.me/234... for check-outpay.com/whatsapp-wallet CTAs
# WHATSAPP_WALLET_CONTACT_URL=
# TTL (minutes) for the secure pay link / intent.
WHATSAPP_WALLET_PARTNER_PAY_INTENT_TTL_MINUTES=30

# CheckoutNow in-app support chat (POST /api/v1/internal/consumer-chat/reply). Generate a long random secret; omit to disable server replies.
# CONSUMER_CHAT_INTERNAL_REPLY_KEY=
# CONSUMER_CHAT_MAX_BODY=4000

# Consumer mobile app: signed pay QR (Receive screen + Transfer scan)
CONSUMER_PAY_QR_BASE_URL=https://app.check-outnow.com
# CONSUMER_PAY_QR_SECRET=  # optional; defaults to APP_KEY

# Checkout Broadcast verify API (POS → wallet). See BROADCAST_VERIFY_API.md
# BROADCAST_ADMIN_KEY=  # required for /api/v1/broadcast/terminals/* (header X-Admin-Key)
# BROADCAST_RATE_LIMIT_VERIFY=120


# Beta Badge Display
# Set to true to show floating "BETA" badge on all pages, false to hide
# If not set, defaults to database setting (can be toggled in Admin Settings)
# SHOW_BETA_BADGE=true

# Developer Program: thank-you page links after application (optional)
# DEVELOPER_PROGRAM_SLACK_URL=https://join.slack.com/t/...
# DEVELOPER_PROGRAM_WHATSAPP_URL=https://chat.whatsapp.com/...